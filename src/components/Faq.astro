---
import Icon from './Icon.astro';
import { preguntas } from '../data/site';

// Datos estructurados para que Google pueda mostrar las preguntas
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: preguntas.map((q) => ({
    '@type': 'Question',
    name: q.p,
    acceptedAnswer: { '@type': 'Answer', text: q.r },
  })),
};
---
<section class="faq section" id="preguntas">
  <svg class="wave wave--top" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true"><path d="M0 40c200-40 420-40 640-10s440 40 800-10V0H0z" fill="var(--white)"/></svg>
  <div class="container faq__inner">
    <header class="section-head reveal">
      <p class="eyebrow">Resolvemos tus dudas</p>
      <h2>Preguntas frecuentes</h2>
      <p>Si no encuentras tu respuesta, escríbenos y con gusto te ayudamos.</p>
    </header>
    <div class="faq__list">
      {preguntas.map((q, i) => (
        <details class="faq__item reveal" open={i === 0}>
          <summary>{q.p} <Icon name="chevron" /></summary>
          <p>{q.r}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>
